# Firebase Web App configuration (Firebase JS SDK)
#
# Phase 1 uses the Firebase JS SDK (works in Expo Go). These values come from the
# Firebase console -> Project settings -> "Your apps" -> Web app (</> icon).
# If a Web app does not exist yet for project `hospital-managmentsystem`, create
# one (it does not need hosting) and copy the generated config here.
#
# The values below are PUBLIC client config (safe to ship in a mobile app); access
# is controlled by Firebase Security Rules, not by hiding these keys.
#
# EXPO_PUBLIC_ prefix is required so Expo inlines them into the client bundle.

EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hospital-managmentsystem.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hospital-managmentsystem
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hospital-managmentsystem.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=160877842485
# Web appId from the registered Web app (format 1:NUMBER:web:HASH).
EXPO_PUBLIC_FIREBASE_APP_ID=1:160877842485:web:xxxxxxxxxxxxxxxx
# Optional — Analytics is NOT used (unsupported in Expo Go / React Native).
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# MVP-only admin signup code. Anyone with this code can register as an admin.
# Stop-gap for Phase 2; real admin provisioning should move server-side later.
EXPO_PUBLIC_ADMIN_SIGNUP_CODE=change-me-admin-code
