rules_version = '2';

// Phase 2 Storage rules. Patient avatars live at avatars/{uid}.jpg.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{fileName} {
      // Anyone signed in can read avatars (so they render in lists).
      allow read: if request.auth != null;
      // A user may only write their own avatar file (avatars/{uid}.jpg) and only
      // reasonably-sized images.
      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '\\.jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /reports/{patientId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
